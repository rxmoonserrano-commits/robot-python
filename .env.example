# Copia este archivo como .env y llena tus datos. NUNCA subas el .env.
# cp .env.example .env

# --- Google Sheets: hoja independiente de este negocio ---
GOOGLE_SHEETS_ID=
# Archivo JSON de la cuenta de servicio de Google (Sheets + Calendar).
GOOGLE_CREDENTIALS_JSON=credenciales-google.json

# --- Gemini: verifica modelos y costos disponibles para tu cuenta ---
GEMINI_API_KEY=
GEMINI_MODEL=
# Opcional: respaldo verificado por el dueño.
GEMINI_MODEL_FALLBACK=

# --- WhatsApp Cloud API (Meta for Developers) ---
WHATSAPP_TOKEN=<redacted>
WHATSAPP_PHONE_NUMBER_ID=TU_PHONE_NUMBER_ID
# Palabra secreta que inventas tú para verificar el webhook en Meta.
VERIFY_TOKEN=<redacted>
# Secreto de la app de Meta (obligatorio): verifica que cada
# webhook venga de Meta de verdad. Meta for Developers → tu app →
# Configuración básica → Secreto de la app → Mostrar.
META_APP_SECRET=<redacted>

# --- Seguridad del dueño (v3.0) ---
# Clave para /pausa y /reporte-semanal. La crea el instalador; sin ella,
# esos endpoints están cerrados. Pon la misma en Render.
ADMIN_TOKEN=<redacted>

# --- Perfil del negocio (v3.0) ---
# Nombre del negocio (opcional). Tipo, con artículo: una clínica, un restaurante, un taller...
# Nombre de la recepcionista que es el robot.
NEGOCIO_NOMBRE=
NEGOCIO_TIPO=una clínica
RECEPCIONISTA_NOMBRE=Ana

# --- Correo del dueño (handoff y reporte semanal) ---
OWNER_EMAIL=dueno@empresa.com
# Gmail: tu correo + una contraseña de aplicación (no tu clave de Google).
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=<redacted>

# --- Calendario y negocio ---
CALENDAR_ID=primary
TIMEZONE=America/Mazatlan
# Duración de cada cita en minutos (en n8n esto era inicio = fin; aquí no).
DURACION_CITA_MINUTOS=60
PAUSA_HUMANO_HORAS=2

# --- Reporte semanal: lunes 08:00 ---
REPORTE_DIA=mon
REPORTE_HORA=8
REPORTE_MINUTO=0

# --- Versión 2: calidad Apple ---
# Segundos que el robot espera, después del ÚLTIMO mensaje del cliente,
# antes de contestar. Si llega otro mensaje, el contador se reinicia.
ESPERA_AGRUPAR_SEGUNDOS=15
